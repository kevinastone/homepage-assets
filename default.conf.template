proxy_cache_path /var/cache/nginx/assets levels=1:2 keys_zone=assets:10m max_size=5g inactive=30d use_temp_path=off;

server {
    listen ${PORT};
    server_name localhost;

    # Static assets
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
    }

    # Shared cache settings for all upstream routes
    proxy_cache assets;
    proxy_cache_valid 200 30d;
    proxy_cache_valid 404 1m;
    proxy_ignore_headers Cache-Control Expires Set-Cookie;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_ssl_server_name on;
    add_header X-Cache-Status $upstream_cache_status;

    # /selfhst/... -> https://cdn.jsdelivr.net/gh/selfhst/icons/...
    location /selfhst/ {
        proxy_intercept_errors on;
        error_page 301 302 307 308 = @handle_redirect;
        proxy_pass https://cdn.jsdelivr.net/gh/selfhst/icons/;
    }

    # /dashboard-icons/... -> https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/...
    location /dashboard-icons/ {
        proxy_intercept_errors on;
        error_page 301 302 307 308 = @handle_redirect;
        proxy_pass https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/;
    }

    location @handle_redirect {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        set $redirect_uri $upstream_http_location;
        proxy_pass $redirect_uri;
    }
}
